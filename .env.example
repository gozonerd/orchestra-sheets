# Database
DATABASE_URL="postgresql://user:password@localhost:5432/orchestra"

# Supabase (if using Supabase)
PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="xxxxx"

# Auth.js
AUTH_SECRET="generate-with-node-c-crypto-randomBytes-32-hex"
AUTH_TRUST_HOST="true"

# OAuth Providers (configure as needed)
AUTH_GITHUB_ID="xxx"
AUTH_GITHUB_SECRET="xxx"
AUTH_GOOGLE_ID="xxx"
AUTH_GOOGLE_SECRET="xxx"

# LLM Provider Keys (encrypted in database, never as env vars in production)
# These are templates only — actual keys stored server-side encrypted
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_API_KEY=""

# KMS (for envelope encryption)
KMS_KEY_ID="arn:aws:kms:region:account:key/xxx"  # or equivalent

# Sentry (error tracking)
PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"

# Environment
NODE_ENV="development"
PUBLIC_APP_URL="http://localhost:5173"
VERCEL_ENV="development"
